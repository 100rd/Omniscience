# === Database (operational metadata: sources, ingestion runs, tokens, workspaces) ===
DATABASE_URL=postgresql+asyncpg://omniscience:omniscience_dev@postgres:5432/omniscience
POSTGRES_PASSWORD=omniscience_dev

# === NATS ===
NATS_URL=nats://nats:4222

# === Embedding ===
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434

# === Observability ===
LOG_LEVEL=info
OTLP_ENDPOINT=
# OTLP_ENDPOINT=http://otel-collector:4317  # uncomment if using OTel collector

# === Application ===
ENVIRONMENT=development
APP_NAME=omniscience
APP_VERSION=0.2.0

# === Background workers (lite-profile toggles, issue #319) ===
# All default to true. The lite profile (docker-compose.lite.yml) sets these
# to false to shed background load for first-run / evaluation deployments.
# DISCOVERY_ENABLED=true
# RECONCILE_ENABLED=true
# SCHEDULER_ENABLED=true
# RETENTION_ENABLED=true

# === Auth ===
# API_TOKEN_SECRET=  # set in production

# === Storage backends (Epic #96 — Neo4j + Qdrant) ===
# As of v0.2 pgvector is removed; only 'neo4j' / 'qdrant' are accepted.
# See CHANGELOG.md §0.2.0 for migration notes from pre-v0.2 installs.
STORAGE_GRAPH_BACKEND=neo4j
STORAGE_VECTOR_BACKEND=qdrant

# === Neo4j (graph store) ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_dev
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_ACQUISITION_TIMEOUT_SECONDS=60
NEO4J_MAX_RETRY_TIME_SECONDS=30
NEO4J_DEFAULT_MAX_DEPTH=3

# Bitemporal write-path rollout flag (ADR-0008 §8 phase 2, issue #130).
# Default 'disabled' keeps PR #104's writer behaviour verbatim. Flip to
# 'enabled' only after the operator-driven backfill completes on a
# representative dataset (see ADR-0008 §8). No-op in #130; gates #131.
GRAPH_BITEMPORAL=disabled

# === Qdrant (vector store) ===
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
# Dev default: the qdrant-client gRPC stack (>=1.12) returns UNAUTHENTICATED
# when no bearer token is sent, even if the server was started with an empty
# API key — so dev mirrors prod and always provides a key. Override per
# environment; rotate this value before exposing the cluster off-host.
QDRANT_API_KEY=qdrant_dev
QDRANT_HTTPS=false
QDRANT_PREFER_GRPC=true
QDRANT_TIMEOUT_SECONDS=10.0

# === Monitoring (docker compose --profile monitoring) ===
# Grafana admin password. The compose file fails fast if this is unset
# when the monitoring profile is started, so it is required only for that
# profile (the default `up` does not start Grafana). Change before exposing.
GRAFANA_ADMIN_PASSWORD=grafana_dev
